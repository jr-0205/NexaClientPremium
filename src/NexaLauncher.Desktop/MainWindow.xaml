<Window x:Class="NexaLauncher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NEXA Client"
        Width="1320" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#071017">
    <Grid Background="#071017">
        <Image Source="Assets/NEXA Background.png" Stretch="UniformToFill" Opacity="0.92" />
        <Border Background="#6003070A" />
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#00000000" />
    </Grid>
</Window>
