{
  "type": "pet",
  "attached_bone": "SHOULDER",
  "model": "lunar:cosmetics/models/gek/pets/general/blackdragon/blackdragon.geo.json",
  "texture": "lunar:cosmetics/models/gek/pets/general/blackdragon/blackdragon.webp",
  "animation": "lunar:cosmetics/models/gek/pets/general/blackdragon/blackdragon.anim.json",
  "state_machine": {
    "name": "molang",
    "controllers": [
      {
        "name": "main_controller",
        "default_transition_ticks": "8",
        "states": [
          {
            "anim": "elytra",
            "plays_when": "q.is_elytra_flying",
            "transition_easing": "easeInOutSine",
            "transition_ticks": "9"
          },
          {
            "anim": "swimming",
            "plays_when": "q.is_swimming",
            "transition_easing": "easeInOutSine",
            "transition_ticks": "9"
          },
          {
            "anim": "water",
            "plays_when": "q.is_in_water",
            "transition_easing": "easeInOutSine"
          },
          {
            "anim": "afk",
            "plays_when": "(c.afk_timer >= 5) && !q.is_in_gui && !q.is_in_preview_model",
            "transition_easing": "easeInOutSine",
            "transition_ticks": "20"
          },
          {
            "anim": "main",
            "plays_when": "(!c.in_special_env && !q.is_elytra_flying && !(c.afk_timer >= 5)) || q.is_in_gui || q.is_in_preview_model || q.is_flying",
            "transition_easing": "easeInOutSine",
            "transition_ticks": "10"
          }
        ]
      }
    ]
  }
}