{
  "type": "pet",
  "special_cosmetic_type": "minime",
  "attached_bone": "SHOULDER",
  "model": "lunar:cosmetics/models/gek/pets/general/slasherminime/slasherminime.geo.json",
  "texture": "lunar:cosmetics/models/gek/pets/general/slasherminime/slasherminime.webp",
  "animation": "lunar:cosmetics/models/gek/pets/general/slasherminime/slasherminime.anim.json",
  "cosmetic_options": [
    {
      "id": "hide Platform",
      "type": "boolean",
      "default": false,
      "molang_query": "o.hide_platform"
    }
  ],
  "state_machine": {
    "name": "molang",
    "controllers": [
      {
        "name": "main_controller",
        "default_transition_ticks": "8",
        "states": [
          {
            "anim": "elytra",
            "plays_when": "q.is_elytra_flying",
            "transition_easing": "easeInOutSine",
            "transition_ticks": "2"
          },
          {
            "anim": "flying",
            "plays_when": "q.is_flying",
            "transition_easing": "easeInOutSine"
          },
          {
            "anim": "swimming",
            "plays_when": "q.is_swimming",
            "transition_easing": "easeInOutSine",
            "transition_ticks": "9"
          },
          {
            "anim": "water",
            "plays_when": "q.is_in_water && !q.is_swimming",
            "transition_easing": "easeInOutSine"
          },
          {
            "anim": "afk",
            "plays_when": "(c.afk_timer >= 5) && !q.is_in_gui && !q.is_in_preview_model && !o.hide_platform",
            "transition_easing": "easeInOutSine"
          },
          {
            "anim": "flying",
            "plays_when": "o.hide_platform",
            "transition_easing": "easeInOutSine"
          },
          {
            "anim": "main",
            "plays_when": "1",
            "transition_easing": "easeInOutSine"
          }
        ]
      }
    ]
  }
}